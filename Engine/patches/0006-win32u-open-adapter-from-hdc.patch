+/******************************************************************************
+ *           NtGdiDdDDIOpenAdapterFromHdc    (win32u.@)
+ *
+ * Aqua: opens the adapter driving the primary display. Wine only had a stub, and Need for Speed:
+ * The Run quits with "Could Not Get Primary Adapter Handle" when neither NVAPI nor AMD ADL is present.
+ */
+NTSTATUS WINAPI NtGdiDdDDIOpenAdapterFromHdc( D3DKMT_OPENADAPTERFROMHDC *desc )
+{
+    NTSTATUS status = STATUS_UNSUCCESSFUL;
+    D3DKMT_OPENADAPTERFROMLUID luid_desc;
+    struct source *source;
 
+    TRACE( "desc %p, hdc %p\n", desc, desc ? desc->hDc : NULL );
 
+    if (!desc || !desc->hDc) return STATUS_INVALID_PARAMETER;
+    if (!(source = find_source( NULL ))) return STATUS_UNSUCCESSFUL;
+
+    luid_desc.AdapterLuid = source->gpu->luid;
+    if (!(status = NtGdiDdDDIOpenAdapterFromLuid( &luid_desc )))
+    {
+        desc->hAdapter = luid_desc.hAdapter;
+        desc->AdapterLuid = luid_desc.AdapterLuid;
+        desc->VidPnSourceId = source->id + 1;
+    }
+
+    source_release( source );
+    return status;
+}
+
