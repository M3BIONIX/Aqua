  "steam:1245620": {
    "renderer": "d3dmetal",
    "environment": {
      "SteamAppId": "1245620"
    },
    "notes": "Elden Ring. Offline only: Easy Anti-Cheat blocks online play under Wine.",
    "display": [
      {
        "format": "xml",
        "file": "%APPDATA%\\EldenRing\\GraphicsConfig.xml",
        "values": {
          "Resolution-FullScreenWidth": "{width}",
          "Resolution-FullScreenHeight": "{height}",
          "Resolution-BorderlessScreenWidth": "{width}",
          "Resolution-BorderlessScreenHeight": "{height}"
        }
      }
    ]
  },
  "steam:292030": {
    "renderer": "d3dmetal",
    "windowsVersion": "win11",
    "arguments": [
      "--launcher-skip"
    ],
    "notes": "The Witcher 3 Remastered (DX12 build).",
