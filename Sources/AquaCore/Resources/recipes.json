  "steam:990080": {
    "renderer": "d3dmetal",
    "notes": "Hogwarts Legacy. Must not fall back to Vulkan. Unreal's outdated-driver warning is turned off: D3DMetal triggers it and it can leave the game stuck after shader compilation.",
    "display": [
      {
        "format": "ini",
        "file": "%LOCALAPPDATA%\\Hogwarts*Legacy\\Saved\\Config\\WindowsNoEditor\\GameUserSettings.ini",
        "values": {
          "ResolutionSizeX": "{width}",
          "ResolutionSizeY": "{height}",
          "LastUserConfirmedResolutionSizeX": "{width}",
          "LastUserConfirmedResolutionSizeY": "{height}",
          "DesiredScreenWidth": "{width}",
          "DesiredScreenHeight": "{height}"
        }
      }
    ],
    "files": [
      {
        "format": "ini",
        "file": "%LOCALAPPDATA%\\Hogwarts*Legacy\\Saved\\Config\\WindowsNoEditor\\Engine.ini",
        "section": "SystemSettings",
        "values": {
          "r.WarnOfBadDrivers": "0"
        }
      }
    ]
  },
